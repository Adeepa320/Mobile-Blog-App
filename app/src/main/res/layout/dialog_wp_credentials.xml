<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Site URL (e.g. https://yourblog.wordpress.com)"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_wp_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://yourblog.wordpress.com"
        android:inputType="textUri"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Client ID (from developer.wordpress.com/apps)"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_client_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Client ID"
        android:inputType="textNoSuggestions"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Client Secret"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_client_secret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Client Secret"
        android:inputType="textPassword"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_oauth_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login with WordPress.com"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_oauth_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Not connected"
        android:textSize="12sp" />

</LinearLayout>
